<!--
  Local custom rules for the enterprise intranet security monitoring lab.

  Purpose:
  - Extend Wazuh default SSH and web rules instead of modifying built-in rules.
  - Keep custom rule IDs in the Wazuh-recommended local range: 100000-120000.
  - Add MITRE ATT&CK mappings for reporting and SOC-style analysis.

  Notes:
  - Default Wazuh rules live in /var/ossec/ruleset/rules/ and should not be edited.
  - This file is intended to be installed as /var/ossec/etc/rules/local_rules.xml.
-->

<!-- Custom correlation rules for SSH authentication and web reconnaissance. -->
<group name="local,">

  <!--
    Detect SSH password brute force based on Wazuh built-in rule 5760.
    Rule 5760 represents a single SSH authentication failure in this lab.
    This rule raises the severity when the same source IP fails 5 times in 60 seconds.
  -->
  <rule id="100010" level="10" frequency="5" timeframe="60">
    <if_matched_sid>5760</if_matched_sid>
    <same_source_ip />
    <description>SSH brute force detected: 5 failed logins from the same source IP within 60 seconds.</description>
    <group>syslog,sshd,ssh_bruteforce,authentication_failed,attack,soc_report,</group>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

  <!--
    Reclassify invalid SSH username attempts based on Wazuh built-in rule 5710.
    This is useful for reporting username guessing activity separately from ordinary
    password failures.
  -->
  <rule id="100011" level="8">
    <if_sid>5710</if_sid>
    <description>Invalid SSH username login attempt detected.</description>
    <group>syslog,sshd,ssh_invalid_user,authentication_failed,attack,soc_report,</group>
    <mitre>
      <id>T1110.001</id>
    </mitre>
  </rule>

  <!--
    Detect SSH username enumeration based on repeated invalid-user events.
    The same source IP triggering built-in rule 5710 four times in 120 seconds
    is treated as likely account discovery or username guessing.
  -->
  <rule id="100012" level="11" frequency="4" timeframe="120">
    <if_matched_sid>5710</if_matched_sid>
    <same_source_ip />
    <description>SSH username enumeration suspected: multiple invalid users from the same source IP.</description>
    <group>syslog,sshd,ssh_user_enum,authentication_failed,reconnaissance,attack,soc_report,</group>
    <mitre>
      <id>T1110.001</id>
    </mitre>
  </rule>

  <!--
    Detect common web scanner and attack-tool fingerprints in web logs.
    This rule inherits from default web-related rules by using the built-in "web"
    group, then searches the raw event for common scanner names and User-Agent
    strings such as Nikto, sqlmap, Gobuster, Nmap, and Masscan.
  -->
  <rule id="100020" level="9">
    <if_group>web</if_group>
    <regex type="pcre2">(?i)(nikto|sqlmap|dirbuster|gobuster|acunetix|nessus|nmap|masscan)</regex>
    <description>Web scanner activity detected by suspicious User-Agent or request pattern.</description>
    <group>web,accesslog,web_scan,reconnaissance,attack,soc_report,</group>
    <mitre>
      <id>T1595</id>
    </mitre>
  </rule>

  <!--
    Detect possible web directory brute force or content discovery.
    The default web access-log decoder stores the HTTP status code in the decoded
    "id" field, and built-in rule 31101 groups HTTP 400-class events. A high
    number of 404 responses from the same source IP in a short time window is
    a common sign of directory brute forcing or web path discovery.
  -->
  <rule id="100021" level="10" frequency="10" timeframe="60">
    <if_matched_sid>31101</if_matched_sid>
    <same_source_ip />
    <id>^404</id>
    <description>Possible web directory brute force: many HTTP 404 responses from the same source IP.</description>
    <group>web,accesslog,web_dir_bruteforce,reconnaissance,attack,soc_report,</group>
    <mitre>
      <id>T1595.002</id>
    </mitre>
  </rule>

</group>
